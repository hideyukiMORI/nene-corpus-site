---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="NeNe Corpus — 開発者向けドキュメント" lang="ja">
  <header class="border-b" style="border-color: var(--color-border);">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
      <div class="flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-md text-white text-xs font-bold"
          style="background: var(--color-brand);">N</span>
        <span class="font-semibold text-sm" style="color: var(--color-fg);">NeNe Corpus</span>
        <span class="rounded px-1.5 py-0.5 text-xs font-medium"
          style="background: var(--color-brand-light); color: var(--color-brand-dark);">dev</span>
      </div>
      <div class="flex items-center gap-4 text-sm" style="color: var(--color-fg-muted);">
        <a href="https://nene-corpus.com" class="hover:text-[--color-brand] transition-colors hidden sm:block">
          nene-corpus.com
        </a>
        <a href="https://github.com/hideyukiMORI/nene-corpus" target="_blank" rel="noopener noreferrer"
          class="hover:text-[--color-brand] transition-colors">GitHub</a>
        <a href="/" class="hover:text-[--color-brand] transition-colors text-xs">EN</a>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-20" style="background: linear-gradient(160deg, #f8faf9, #ffffff);">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl" style="color: var(--color-fg);">
        開発者向けドキュメント
      </h1>
      <p class="mb-2 text-lg" style="color: var(--color-fg-muted);">
        API リファレンス・アーキテクチャ・ウィジェット埋め込みガイド・セルフホスト手順。
      </p>
      <p class="text-sm" style="color: var(--color-fg-subtle);">
        NeNe Corpus — 自己ホスト型ナレッジチャット OSS
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/docs/getting-started"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">🚀</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">はじめる</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          共用ホスティング（Tier A）または Docker/VPS（Tier B）へのインストール手順。
        </p>
      </a>
      <a href="/docs/widget"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">🔌</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">ウィジェット埋め込み</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          1行のコードで既存サイトにチャットウィジェットを追加する方法。
        </p>
      </a>
      <a href="/docs/api"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">📡</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">API リファレンス</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          ソース・インジェスト・チャット・管理操作の REST エンドポイント一覧。
        </p>
      </a>
      <a href="/docs/architecture"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">🏗️</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">アーキテクチャ</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          PHP レイヤー構造・モジュール構成・DB スキーマ・フロントエンド構成。
        </p>
      </a>
      <a href="/docs/configuration"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">⚙️</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">設定リファレンス</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          環境変数・LLM 設定・利用制限・SMTP メール通知の設定方法。
        </p>
      </a>
    </div>
  </section>

  <footer class="border-t py-8" style="border-color: var(--color-border);">
    <div class="mx-auto max-w-6xl px-4 text-center text-xs sm:px-6" style="color: var(--color-fg-subtle);">
      © {new Date().getFullYear()} NeNe Corpus — MIT License ·
      <a href="https://ayane.co.jp" target="_blank" rel="noopener noreferrer"
        class="hover:text-[--color-brand] transition-colors ml-1">ayane.co.jp</a>
    </div>
  </footer>
</Layout>
