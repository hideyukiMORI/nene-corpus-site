---
import Layout from '../layouts/Layout.astro';
---

<Layout title="NeNe Corpus — Developer Docs">
  <!-- Header -->
  <header class="border-b" style="border-color: var(--color-border);">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
      <div class="flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-md text-white text-xs font-bold"
          style="background: var(--color-brand);">N</span>
        <span class="font-semibold text-sm" style="color: var(--color-fg);">NeNe Corpus</span>
        <span class="rounded px-1.5 py-0.5 text-xs font-medium"
          style="background: var(--color-brand-light); color: var(--color-brand-dark);">dev</span>
      </div>
      <div class="flex items-center gap-4 text-sm" style="color: var(--color-fg-muted);">
        <a href="https://nene-corpus.com" class="hover:text-[--color-brand] transition-colors hidden sm:block">
          nene-corpus.com
        </a>
        <a href="https://github.com/hideyukiMORI/nene-corpus" target="_blank" rel="noopener noreferrer"
          class="hover:text-[--color-brand] transition-colors">GitHub</a>
        <a href="/ja/" class="hover:text-[--color-brand] transition-colors text-xs">JA</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="py-16 sm:py-20" style="background: linear-gradient(160deg, #f8faf9, #ffffff);">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium"
        style="background: var(--color-brand-light); color: var(--color-brand-dark);">
        <span class="h-1.5 w-1.5 rounded-full" style="background: var(--color-brand);"></span>
        Self-Hosted · Open Source · MIT
      </div>
      <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl" style="color: var(--color-fg);">
        Developer Docs
      </h1>
      <p class="mb-2 text-lg" style="color: var(--color-fg-muted);">
        API reference, architecture, widget integration, and self-hosting guides.
      </p>
      <p class="text-sm" style="color: var(--color-fg-subtle);">
        NeNe Corpus — self-hosted knowledge chat OSS. Ingest documents, chat with citations, keep data on your stack.
      </p>
    </div>
  </section>

  <!-- Cards grid -->
  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

      <!-- Getting Started -->
      <a href="/docs/getting-started"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">🚀</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">Getting Started</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          Install NeNe Corpus on shared hosting (Tier A) or Docker/VPS (Tier B).
        </p>
        <span class="mt-3 text-xs font-medium" style="color: var(--color-brand);">
          Tier A · Tier B →
        </span>
      </a>

      <!-- Widget -->
      <a href="/docs/widget"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">🔌</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">Widget Integration</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          Embed the chat widget on any existing site with a single <code>&lt;script&gt;</code> tag.
        </p>
        <span class="mt-3 text-xs font-medium" style="color: var(--color-brand);">
          Embed guide →
        </span>
      </a>

      <!-- API Reference -->
      <a href="/docs/api"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">📡</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">API Reference</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          REST endpoints for sources, ingestion, chat sessions, and admin operations.
        </p>
        <span class="mt-3 text-xs font-medium" style="color: var(--color-brand);">
          OpenAPI spec →
        </span>
      </a>

      <!-- Architecture -->
      <a href="/docs/architecture"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">🏗️</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">Architecture</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          PHP layered architecture, module structure, DB schema, and frontend monorepo layout.
        </p>
        <span class="mt-3 text-xs font-medium" style="color: var(--color-brand);">
          Deep dive →
        </span>
      </a>

      <!-- Configuration -->
      <a href="/docs/configuration"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border);">
        <div class="mb-3 text-2xl">⚙️</div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">Configuration</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          Environment variables, LLM settings, rate limits, and SMTP notification setup.
        </p>
        <span class="mt-3 text-xs font-medium" style="color: var(--color-brand);">
          Reference →
        </span>
      </a>

      <!-- GitHub -->
      <a href="https://github.com/hideyukiMORI/nene-corpus"
        target="_blank" rel="noopener noreferrer"
        class="group flex flex-col rounded-2xl border p-6 transition-shadow hover:shadow-md"
        style="border-color: var(--color-border); background: var(--color-bg-muted);">
        <div class="mb-3 text-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-fg-muted);"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </div>
        <h2 class="mb-1.5 text-base font-semibold group-hover:text-[--color-brand] transition-colors"
          style="color: var(--color-fg);">Source Code</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">
          MIT licensed. Issues, PRs, and contributions welcome on GitHub.
        </p>
        <span class="mt-3 text-xs font-medium" style="color: var(--color-brand);">
          github.com/hideyukiMORI/nene-corpus →
        </span>
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t py-8" style="border-color: var(--color-border);">
    <div class="mx-auto max-w-6xl px-4 text-center text-xs sm:px-6" style="color: var(--color-fg-subtle);">
      © {new Date().getFullYear()} NeNe Corpus — MIT License ·
      <a href="https://ayane.co.jp" target="_blank" rel="noopener noreferrer"
        class="hover:text-[--color-brand] transition-colors ml-1">ayane.co.jp</a>
    </div>
  </footer>
</Layout>
