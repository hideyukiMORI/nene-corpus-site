---
export interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;

const t = {
  ja: {
    badge: 'MIT ライセンス · 完全自己ホスト',
    title1: 'ドキュメントをアップロードして',
    title2: '引用付きチャットボットを作ろう',
    description:
      'NeNe Corpus は自己ホスト型ナレッジチャット OSS。PDF・CSV をアップロードしてコーパスを構築し、Claude AI が出典を明示した回答で顧客の質問に答えます。さくら・ヘテムル等の共用サーバーから Docker まで対応。',
    cta1: 'セットアップガイドを見る',
    cta2: 'GitHub でスターをつける',
    tier: 'さくら・ヘテムルなどの共用サーバーに対応',
  },
  en: {
    badge: 'MIT License · Fully self-hosted',
    title1: 'Upload documents,',
    title2: 'build a chatbot with citations',
    description:
      'NeNe Corpus is a self-hosted knowledge chat OSS. Upload PDFs and CSVs to build a corpus, then let Claude AI answer visitor questions with source citations. Works on shared hosting (Sakura, Heteml) and Docker/VPS.',
    cta1: 'Read the Setup Guide',
    cta2: 'Star on GitHub',
    tier: 'Works on shared hosting · Docker · VPS',
  },
}[lang];
---

<section
  class="relative overflow-hidden py-20 sm:py-28"
  style="background: linear-gradient(160deg, #f8faf9 0%, #ffffff 50%, #f0f7f5 100%);"
>
  <!-- Decorative blob -->
  <div
    class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full opacity-20 blur-3xl"
    style="background: var(--color-brand);"
  ></div>
  <div
    class="pointer-events-none absolute bottom-0 -left-24 h-64 w-64 rounded-full opacity-10 blur-3xl"
    style="background: var(--color-brand);"
  ></div>

  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
    <!-- Badge -->
    <div class="mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium"
      style="border-color: var(--color-brand-light); background: var(--color-brand-light); color: var(--color-brand-dark);">
      <span class="h-1.5 w-1.5 rounded-full" style="background: var(--color-brand);"></span>
      {t.badge}
    </div>

    <!-- Title -->
    <h1 class="mb-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      style="color: var(--color-fg);">
      {t.title1}<br />{t.title2}
    </h1>

    <!-- Description -->
    <p class="mx-auto mb-8 max-w-2xl text-base leading-relaxed sm:text-lg"
      style="color: var(--color-fg-muted);">
      {t.description}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="https://nene-corpus.dev"
        class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:opacity-90 hover:shadow-md"
        style="background: var(--color-brand);"
      >
        {t.cta1}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a
        href="https://github.com/hideyukiMORI/nene-corpus"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border px-6 py-3 text-sm font-semibold transition-all hover:bg-[--color-bg-muted]"
        style="border-color: var(--color-border); color: var(--color-fg);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        {t.cta2}
      </a>
    </div>

    <!-- Tier note -->
    <p class="mt-6 text-xs" style="color: var(--color-fg-subtle);">
      ✓ {t.tier}
    </p>
  </div>
</section>
