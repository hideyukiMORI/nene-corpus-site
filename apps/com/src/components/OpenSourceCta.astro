---
export interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;

const t = {
  ja: {
    badge: 'オープンソース · MIT',
    heading: 'NeNe Corpus はオープンソースです',
    body: 'ソースコードはすべて公開。フォーク・カスタマイズ・コントリビュートを歓迎します。',
    cta1: 'GitHub を見る',
    cta2: 'ドキュメント (nene-corpus.dev)',
  },
  en: {
    badge: 'Open Source · MIT',
    heading: 'NeNe Corpus is open source',
    body: 'All source code is public. Fork, customize, and contribute — welcome.',
    cta1: 'View on GitHub',
    cta2: 'Documentation (nene-corpus.dev)',
  },
}[lang];
---

<section
  class="py-20 sm:py-24"
  style="background: var(--color-brand-light);"
>
  <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
    <div
      class="mb-4 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium"
      style="background: var(--color-brand); color: #fff;"
    >
      {t.badge}
    </div>
    <h2 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--color-fg);">
      {t.heading}
    </h2>
    <p class="mb-8 text-base" style="color: var(--color-fg-muted);">{t.body}</p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="https://github.com/hideyukiMORI/nene-corpus"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:opacity-90"
        style="background: var(--color-brand);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        {t.cta1}
      </a>
      <a
        href="https://nene-corpus.dev"
        class="inline-flex items-center gap-2 rounded-xl border px-6 py-3 text-sm font-semibold transition-all hover:bg-white"
        style="border-color: var(--color-brand); color: var(--color-brand-dark);"
      >
        {t.cta2}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
      </a>
    </div>
  </div>
</section>
