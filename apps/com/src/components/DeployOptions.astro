---
export interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;

const t = {
  ja: {
    heading: '2つの導入方法',
    subheading: 'どんな環境にも対応。Tier A は非エンジニアのオペレーターでも導入できます。',
    tierA: {
      label: 'Tier A',
      title: '共用ホスティング',
      badge: 'さくら・ヘテムル対応',
      description: 'Web ブラウザだけで完結。コマンドラインもサーバー知識も不要。',
      steps: [
        'リリース ZIP をダウンロード',
        'FTP でサーバーにアップロード',
        'ブラウザで Web インストーラーを開く',
        '設定を入力して完了',
      ],
      cta: '共用サーバー向けガイド',
      href: 'https://nene-corpus.dev/docs/getting-started/tier-a',
    },
    tierB: {
      label: 'Tier B',
      title: 'Docker / VPS',
      badge: '推奨',
      description: 'Docker Compose 1コマンドで起動。本番環境・開発環境どちらにも対応。',
      steps: [
        'リポジトリをクローン',
        '.env を設定',
        'docker compose up --build -d',
        '完了',
      ],
      cta: 'Docker 向けガイド',
      href: 'https://nene-corpus.dev/docs/getting-started/tier-b',
    },
  },
  en: {
    heading: 'Two deployment options',
    subheading: 'Designed for both non-technical operators and developers.',
    tierA: {
      label: 'Tier A',
      title: 'Shared Hosting',
      badge: 'Sakura · Heteml ready',
      description: 'Browser-only setup. No command line or server expertise required.',
      steps: [
        'Download the release ZIP',
        'Upload via FTP',
        'Open the web installer in your browser',
        'Fill in settings — done',
      ],
      cta: 'Shared hosting guide',
      href: 'https://nene-corpus.dev/docs/getting-started/tier-a',
    },
    tierB: {
      label: 'Tier B',
      title: 'Docker / VPS',
      badge: 'Recommended',
      description: 'One-command startup with Docker Compose. Production and dev environments.',
      steps: [
        'Clone the repository',
        'Configure .env',
        'docker compose up --build -d',
        'Done',
      ],
      cta: 'Docker guide',
      href: 'https://nene-corpus.dev/docs/getting-started/tier-b',
    },
  },
}[lang];
---

<section id="deploy" class="py-20 sm:py-24" style="background: var(--color-bg);">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="mb-14 text-center">
      <h2 class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--color-fg);">
        {t.heading}
      </h2>
      <p class="text-base" style="color: var(--color-fg-muted);">{t.subheading}</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {[t.tierA, t.tierB].map((tier) => (
        <div
          class="flex flex-col rounded-2xl border p-6"
          style="border-color: var(--color-border);"
        >
          <div class="mb-4 flex items-center gap-3">
            <span
              class="rounded-md px-2 py-0.5 text-xs font-bold text-white"
              style="background: var(--color-brand);"
            >{tier.label}</span>
            <h3 class="text-base font-semibold" style="color: var(--color-fg);">{tier.title}</h3>
            <span
              class="ml-auto rounded-full px-2 py-0.5 text-xs font-medium"
              style="background: var(--color-brand-light); color: var(--color-brand-dark);"
            >{tier.badge}</span>
          </div>

          <p class="mb-5 text-sm" style="color: var(--color-fg-muted);">{tier.description}</p>

          <ol class="mb-6 flex flex-col gap-2">
            {tier.steps.map((step, i) => (
              <li class="flex items-start gap-2 text-sm" style="color: var(--color-fg-muted);">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                  style="background: var(--color-brand);"
                >{i + 1}</span>
                {step}
              </li>
            ))}
          </ol>

          <a
            href={tier.href}
            class="mt-auto inline-flex items-center gap-1.5 text-sm font-medium transition-colors hover:opacity-80"
            style="color: var(--color-brand);"
          >
            {tier.cta}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
