---
export interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;

const t = {
  ja: {
    heading: '4ステップで始められる',
    steps: [
      {
        n: '01',
        title: 'ドキュメントをアップロード',
        body: 'Admin UI から PDF・CSV・テキストをアップロード。複数ファイルを一括登録できます。',
      },
      {
        n: '02',
        title: 'コーパスを自動構築',
        body: 'テキストを自動でチャンクに分割し、全文検索インデックスを構築。設定は不要です。',
      },
      {
        n: '03',
        title: 'ウィジェットを埋め込む',
        body: '管理画面からスニペットをコピーし、既存サイトの </body> 直前に貼り付けるだけ。',
      },
      {
        n: '04',
        title: 'AI が引用付きで回答',
        body: '訪問者の質問に Claude AI が関連ドキュメントを引用しながら回答。サポートコストを削減。',
      },
    ],
  },
  en: {
    heading: 'Up and running in 4 steps',
    steps: [
      {
        n: '01',
        title: 'Upload your documents',
        body: 'Upload PDFs, CSVs, or plain text via the Admin UI. Bulk upload is supported.',
      },
      {
        n: '02',
        title: 'Corpus is built automatically',
        body: 'Text is split into searchable chunks and indexed automatically. No configuration needed.',
      },
      {
        n: '03',
        title: 'Embed the widget',
        body: 'Copy the snippet from the admin panel and paste it before </body> on your existing site.',
      },
      {
        n: '04',
        title: 'AI answers with citations',
        body: 'Visitors ask questions, Claude AI responds with cited document excerpts. Reduce support load.',
      },
    ],
  },
}[lang];
---

<section
  id="how-it-works"
  class="py-20 sm:py-24"
  style="background: var(--color-bg-muted);"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 class="mb-14 text-center text-3xl font-bold tracking-tight sm:text-4xl"
      style="color: var(--color-fg);">
      {t.heading}
    </h2>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {t.steps.map((step) => (
        <div class="flex flex-col gap-3">
          <div
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-sm font-bold text-white"
            style="background: var(--color-brand);"
          >
            {step.n}
          </div>
          <h3 class="text-sm font-semibold" style="color: var(--color-fg);">{step.title}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted);">{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
